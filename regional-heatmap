<!DOCTYPE html>
<!--
  区域经营热力图谱 · 作品展示版
  说明：本页面用于个人技术作品展示。GMV、毛利值、毛利率、单客价值、成交票量
       五个字段全部经过脱敏处理，逐条独立扰动并整体缩放；
       单条每字段相对原值失真均超过 15%，顶部汇总口径
       （总营业额 / 总毛利 / 平均毛利率）与聚合客单价同样超过 15%，
       已校验派生指标与聚合指标均不存在方向抵消。
       页面仅保留数据结构与可视化逻辑，不代表任何企业的真实经营结果；
       区域标识使用匿名代号。
-->
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>四川景区 · 区域经营热力图谱（示意数据）</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,700&family=Noto+Serif+SC:wght@400;500;700;900&family=Noto+Sans+SC:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
/* ============================================================
   设计代币 —— 米白纸面 / 墨色 / 朱砂
   ============================================================ */
:root {
  --paper-0: #f5efe2;
  --paper-1: #faf6ec;
  --paper-2: #fffbf2;
  --paper-3: #ffffff;

  --ink-0:   #1a1612;
  --ink-1:   #3a342c;
  --ink-2:   #6b6155;
  --ink-3:   #a59a8a;

  --line:    rgba(26,22,18,0.08);
  --line-2:  rgba(26,22,18,0.16);

  --cinnabar:    #c5462e;
  --cinnabar-d:  #9e3622;
  --cinnabar-soft: rgba(197,70,46,0.08);

  --amber:   #d9a14f;
  --jade:    #5e8f6b;
  --indigo:  #3a5d7e;

  /* 两个区域身份色 —— 与朱砂主色相配 */
  --mgr-a:  #3a5d7e;   /* 区域 A · 靛蓝 */
  --mgr-b:  #9e3622;   /* 区域 B · 深朱 */

  --shadow-1: 0 1px 3px rgba(60,40,20,0.06), 0 8px 24px -8px rgba(60,40,20,0.12);
  --shadow-2: 0 4px 12px rgba(60,40,20,0.08), 0 24px 48px -12px rgba(60,40,20,0.18);
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html, body { height: 100%; overflow: hidden; background: var(--paper-0); color: var(--ink-0); }
body {
  font-family: "Noto Sans SC", "Noto Serif SC", -apple-system, sans-serif;
  font-size: 15.5px;
  -webkit-font-smoothing: antialiased;
}

/* 全局纸面噪点 */
body::before {
  content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 9999;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.5  0 0 0 0 0.4  0 0 0 0 0.2  0 0 0 0.05 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  mix-blend-mode: multiply; opacity: 0.5;
}

/* ============================================================
   顶部 · 报刊式标题栏
   ============================================================ */
.masthead {
  position: relative; z-index: 100;
  height: 104px; padding: 0 40px;
  display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 36px;
  background: var(--paper-1);
  border-bottom: 2px solid var(--ink-0);
}
.masthead::after {
  content: ""; position: absolute; left: 0; right: 0; bottom: -7px; height: 1px;
  background: var(--ink-0);
}

.brand { display: flex; align-items: center; gap: 18px; }
.brand .seal {
  width: 58px; height: 58px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: var(--cinnabar); color: var(--paper-2);
  font-family: "Noto Serif SC", serif; font-weight: 900; font-size: 25px;
  letter-spacing: -0.05em; border-radius: 4px;
  box-shadow: 0 2px 0 var(--cinnabar-d), inset 0 0 0 2px rgba(255,255,255,0.15);
  position: relative;
}
.brand .seal::before {
  content: "印"; position: absolute; top: 3px; right: 5px; font-size: 10px; opacity: 0.5;
}
.brand .name {
  font-family: "Noto Serif SC", serif; font-weight: 900; font-size: 27px;
  letter-spacing: 0.04em; color: var(--ink-0); line-height: 1.1;
}
.brand .name .bullet { color: var(--cinnabar); font-weight: 400; margin: 0 6px; }
.brand .sub {
  font-size: 13px; color: var(--ink-2); margin-top: 5px;
  letter-spacing: 0.12em; transition: color .3s;
}

/* 顶部 KPI 条 */
.ribbon { display: flex; gap: 36px; justify-content: center; align-items: center; }
.ribbon .kpi { text-align: left; position: relative; padding-left: 16px; }
.ribbon .kpi::before {
  content: ""; position: absolute; left: 0; top: 4px; bottom: 4px; width: 2px;
  background: var(--cinnabar);
}
.ribbon .kpi .lbl {
  font-family: "Noto Serif SC", serif; font-weight: 500; font-size: 13.5px;
  color: var(--ink-2); margin-bottom: 5px; letter-spacing: 0.1em;
}
.ribbon .kpi .val {
  font-family: "Fraunces", "Noto Serif SC", serif; font-weight: 700; font-size: 26px;
  color: var(--ink-0); letter-spacing: -0.01em; line-height: 1;
  font-variation-settings: "opsz" 144;
  transition: color .25s;
}
.ribbon .kpi .val .unit {
  font-family: "Noto Sans SC", sans-serif; font-size: 13.5px; color: var(--ink-2);
  margin-left: 4px; font-weight: 400;
}

.meta { text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
.demo-badge {
  display: inline-block; padding: 3px 9px; margin-right: 9px;
  font-family: "Noto Serif SC", serif; font-weight: 700; font-size: 11px;
  color: var(--paper-2); background: var(--cinnabar); border-radius: 3px;
  letter-spacing: 0.14em; vertical-align: 1px;
}
.meta .period {
  font-family: "Fraunces", serif; font-weight: 500; font-size: 14.5px;
  color: var(--ink-1); letter-spacing: 0.05em;
}

/* 区域切换 —— 印章式 tab */
.mgr-tabs { display: flex; gap: 8px; }
.mgr-tab {
  display: flex; align-items: center; gap: 8px;
  padding: 6px 12px 6px 8px; cursor: pointer; user-select: none;
  background: var(--paper-2); border: 1px solid var(--line-2); border-radius: 6px;
  transition: all .2s ease;
  position: relative;
}
.mgr-tab .mini-seal {
  width: 26px; height: 26px; display: flex; align-items: center; justify-content: center;
  font-family: "Noto Serif SC", serif; font-weight: 900; font-size: 15px;
  color: var(--paper-2); border-radius: 3px;
  letter-spacing: -0.05em;
}
.mgr-tab[data-mgr="all"]  .mini-seal { background: var(--ink-0); }
.mgr-tab[data-mgr="a"] .mini-seal { background: var(--mgr-a); }
.mgr-tab[data-mgr="b"]   .mini-seal { background: var(--mgr-b); }
.mgr-tab .txt {
  display: flex; flex-direction: column; align-items: flex-start; gap: 1px;
}
.mgr-tab .txt .n {
  font-family: "Noto Serif SC", serif; font-weight: 700; font-size: 13.5px;
  color: var(--ink-0); letter-spacing: 0.05em; line-height: 1.15;
}
.mgr-tab .txt .r {
  font-family: "Fraunces", serif; font-size: 11.5px; color: var(--ink-2);
  letter-spacing: 0.02em; line-height: 1.1;
}
.mgr-tab:hover:not(.active) { border-color: var(--ink-1); background: var(--paper-3); }
.mgr-tab.active {
  border-color: var(--ink-0);
  box-shadow: 0 2px 0 var(--cinnabar), inset 0 0 0 1px var(--ink-0);
  background: var(--paper-3);
}
.mgr-tab.active .txt .n { color: var(--ink-0); }

/* ============================================================
   主体布局
   ============================================================ */
.stage { display: grid; grid-template-columns: 1fr 440px; height: calc(100% - 104px); }

/* ============================================================
   地图区
   ============================================================ */
.canvas { position: relative; background: var(--paper-1); overflow: hidden; }
#map { position: absolute; inset: 0; background: var(--paper-1); }

.leaflet-tile-pane {
  filter: grayscale(85%) sepia(18%) saturate(0.85) brightness(1.04) contrast(0.92);
}

.leaflet-control-zoom { border: none !important; box-shadow: var(--shadow-1) !important; margin: 20px !important; border-radius: 8px; overflow: hidden; }
.leaflet-control-zoom a {
  background: var(--paper-2) !important; color: var(--ink-0) !important;
  border: 1px solid var(--line-2) !important;
  width: 36px !important; height: 36px !important; line-height: 34px !important;
  font-family: "Fraunces", serif !important; font-size: 18px !important;
}
.leaflet-control-zoom a:hover { background: var(--cinnabar) !important; color: #fff !important; }

/* 角标十字 */
.crosshair { position: absolute; pointer-events: none; z-index: 400; width: 32px; height: 32px; }
.crosshair::before, .crosshair::after { content: ""; position: absolute; background: var(--ink-0); opacity: 0.35; }
.crosshair.tl { top: 24px; left: 24px; }
.crosshair.tr { top: 24px; right: 24px; }
.crosshair.bl { bottom: 24px; left: 24px; }
.crosshair.br { bottom: 24px; right: 24px; }
.crosshair::before { width: 1px; height: 18px; }
.crosshair::after  { height: 1px; width: 18px; }
.crosshair.tl::before { left: 0; top: 0 } .crosshair.tl::after { top: 0; left: 0 }
.crosshair.tr::before { right: 0; top: 0 } .crosshair.tr::after { top: 0; right: 0 }
.crosshair.bl::before { left: 0; bottom: 0 } .crosshair.bl::after { bottom: 0; left: 0 }
.crosshair.br::before { right: 0; bottom: 0 } .crosshair.br::after { bottom: 0; right: 0 }

/* 地图大字 · 地名牌 */
.geo-tag { position: absolute; top: 60px; left: 60px; z-index: 500; pointer-events: none; }
.geo-tag .badge {
  display: inline-block;
  font-family: "Noto Serif SC", serif; font-size: 14px; font-weight: 500;
  color: var(--cinnabar); letter-spacing: 0.3em; margin-bottom: 14px;
  padding: 5px 14px; border: 1px solid var(--cinnabar); border-radius: 2px;
  background: rgba(250,246,236,0.6); backdrop-filter: blur(6px);
}
.geo-tag .name {
  font-family: "Noto Serif SC", serif; font-size: 84px; font-weight: 900;
  color: var(--ink-0); letter-spacing: 0.05em; line-height: 1;
  text-shadow: 0 2px 30px rgba(255,251,242,0.8);
}
.geo-tag .rule {
  width: 88px; height: 3px; background: var(--cinnabar); margin-top: 18px;
  transition: background .3s;
}
.geo-tag .coord {
  font-family: "Fraunces", serif; font-size: 14.5px; color: var(--ink-2);
  margin-top: 14px; letter-spacing: 0.08em; font-style: italic;
  transition: color .3s;
}
.geo-tag .mgr-line {
  font-family: "Noto Serif SC", serif; font-size: 13.5px; margin-top: 8px;
  color: var(--ink-2); letter-spacing: 0.12em;
}
.geo-tag .mgr-line .who {
  font-weight: 700; color: var(--ink-0); margin-left: 6px;
}
.geo-tag .mgr-line .who[data-m="a"] { color: var(--mgr-a); }
.geo-tag .mgr-line .who[data-m="b"]   { color: var(--mgr-b); }

/* ============================================================
   图例 · 浮卡（左下）
   ============================================================ */
.legend {
  position: absolute; left: 36px; bottom: 36px; z-index: 500;
  background: var(--paper-2);
  border: 1px solid var(--line-2); border-radius: 12px;
  padding: 24px 28px; min-width: 380px; box-shadow: var(--shadow-2);
}
.legend .ttl {
  font-family: "Noto Serif SC", serif; font-weight: 700; font-size: 18px;
  color: var(--ink-0); margin-bottom: 6px; letter-spacing: 0.02em;
}
.legend .ttl em { font-style: normal; color: var(--cinnabar); }
.legend .desc {
  font-size: 13px; color: var(--ink-2); margin-bottom: 18px; line-height: 1.55;
}
.legend .scale {
  height: 14px; border-radius: 3px;
  background: linear-gradient(90deg,
    rgb(82,96,180)   0%,
    rgb(95,161,215)  20%,
    rgb(122,199,145) 40%,
    rgb(230,220,90)  60%,
    rgb(235,140,55)  80%,
    rgb(220,55,55)   100%
  );
  border: 1px solid var(--line-2);
  position: relative;
}
.legend .ticks {
  display: flex; justify-content: space-between; margin-top: 10px;
  font-family: "Fraunces", serif; font-size: 14px; color: var(--ink-1); font-weight: 500;
}
.legend .ticks .lbl-row {
  display: flex; justify-content: space-between; margin-top: 2px;
  font-family: "Noto Sans SC", sans-serif; font-size: 12px; color: var(--ink-2);
}

/* ============================================================
   景点标记 —— v4:全部墨色，仅四大景区朱砂高亮
   ============================================================ */
.attr-marker {
  width: 14px; height: 14px; border-radius: 50%;
  background: var(--ink-0);
  box-shadow:
    0 0 0 2px var(--paper-1),
    0 0 0 3px var(--ink-0),
    0 2px 4px rgba(0, 0, 0, 0.2);
  cursor: pointer;
  transition: transform 0.18s ease;
  position: relative;
}
/* v4 · 四大景区朱砂高亮 */
.attr-marker.hl {
  width: 16px; height: 16px;
  background: var(--cinnabar);
  box-shadow:
    0 0 0 2px var(--paper-1),
    0 0 0 3px var(--cinnabar-d),
    0 0 12px 2px rgba(197,70,46,0.55),
    0 2px 6px rgba(0, 0, 0, 0.25);
  animation: hl-pulse 2.4s ease-in-out infinite;
}
@keyframes hl-pulse {
  0%, 100% { box-shadow:
    0 0 0 2px var(--paper-1),
    0 0 0 3px var(--cinnabar-d),
    0 0 12px 2px rgba(197,70,46,0.55),
    0 2px 6px rgba(0, 0, 0, 0.25); }
  50% { box-shadow:
    0 0 0 2px var(--paper-1),
    0 0 0 3px var(--cinnabar-d),
    0 0 18px 4px rgba(197,70,46,0.75),
    0 2px 6px rgba(0, 0, 0, 0.25); }
}
.attr-marker::after {
  content: ""; position: absolute; inset: -10px; border-radius: 50%;
  background: radial-gradient(circle, rgba(26,22,18,0.18) 0%, transparent 70%);
  opacity: 0; transition: opacity 0.2s;
}
.attr-marker:hover {
  transform: scale(1.55);
  box-shadow:
    0 0 0 2px var(--paper-1),
    0 0 0 3px var(--cinnabar),
    0 4px 12px rgba(197,70,46,0.4);
}
.attr-marker.hl:hover {
  transform: scale(1.5);
  animation: none;
  box-shadow:
    0 0 0 2px var(--paper-1),
    0 0 0 3px var(--cinnabar-d),
    0 0 20px 6px rgba(197,70,46,0.85),
    0 4px 12px rgba(0, 0, 0, 0.3);
}
.attr-marker:hover::after { opacity: 1; }
/* 区域识别外环 */
.attr-marker.m-a { box-shadow:
    0 0 0 2px var(--paper-1),
    0 0 0 3px var(--mgr-a),
    0 2px 4px rgba(0, 0, 0, 0.2); }
.attr-marker.m-b { box-shadow:
    0 0 0 2px var(--paper-1),
    0 0 0 3px var(--mgr-b),
    0 2px 4px rgba(0, 0, 0, 0.2); }
.attr-marker.m-a:hover, .attr-marker.m-b:hover {
  box-shadow:
    0 0 0 2px var(--paper-1),
    0 0 0 3px var(--cinnabar),
    0 4px 12px rgba(197,70,46,0.4);
}

.leaflet-marker-icon.leaflet-interactive .attr-marker { transition: transform 0.18s ease, box-shadow 0.18s ease; }

/* ============================================================
   弹窗 · 卡片样式
   ============================================================ */
.leaflet-popup-content-wrapper {
  background: var(--paper-2) !important; color: var(--ink-0) !important;
  border: 1px solid var(--line-2); border-radius: 12px !important;
  box-shadow: var(--shadow-2) !important; padding: 0 !important;
}
.leaflet-popup-content { margin: 0 !important; padding: 24px 26px !important; min-width: 340px; line-height: 1.6; }
.leaflet-popup-tip { background: var(--paper-2) !important; border-color: var(--line-2) !important; }
.leaflet-popup-close-button {
  color: var(--ink-2) !important; padding: 10px 10px 0 0 !important;
  font-size: 20px !important;
}
.leaflet-popup-close-button:hover { color: var(--cinnabar) !important; }

.popup .tag-row {
  display: flex; align-items: center; gap: 8px; margin-bottom: 12px;
}
.popup .tag {
  display: inline-block; padding: 4px 12px;
  font-family: "Noto Serif SC", serif; font-weight: 500; font-size: 12px;
  color: var(--cinnabar); background: var(--cinnabar-soft);
  border: 1px solid var(--cinnabar); border-radius: 100px;
  letter-spacing: 0.1em;
}
.popup .mgr-chip {
  display: inline-flex; align-items: center; gap: 4px;
  font-family: "Noto Serif SC", serif; font-weight: 500; font-size: 12px;
  padding: 4px 10px 4px 7px; border-radius: 100px; letter-spacing: 0.05em;
}
.popup .mgr-chip::before {
  content: ""; display: inline-block; width: 8px; height: 8px; border-radius: 2px;
}
.popup .mgr-chip.m-a { color: var(--mgr-a); background: rgba(58,93,126,0.08); border: 1px solid rgba(58,93,126,0.35); }
.popup .mgr-chip.m-a::before { background: var(--mgr-a); }
.popup .mgr-chip.m-b   { color: var(--mgr-b); background: rgba(158,54,34,0.08); border: 1px solid rgba(158,54,34,0.35); }
.popup .mgr-chip.m-b::before   { background: var(--mgr-b); }

.popup .ttl {
  font-family: "Noto Serif SC", serif; font-weight: 900; font-size: 24px;
  color: var(--ink-0); letter-spacing: 0.01em; line-height: 1.2; margin-bottom: 8px;
}
.popup .region {
  font-size: 13px; color: var(--ink-2); margin-bottom: 18px;
  display: flex; align-items: center; gap: 6px;
}
.popup .region::before {
  content: "◆"; color: var(--cinnabar); font-size: 9px;
}
.popup .grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 16px 24px;
  padding-top: 16px; border-top: 1px dashed var(--line-2);
}
.popup .grid .cell .lbl {
  font-family: "Noto Serif SC", serif; font-weight: 500; font-size: 13px;
  color: var(--ink-2); margin-bottom: 5px; letter-spacing: 0.05em;
}
.popup .grid .cell .val {
  font-family: "Fraunces", "Noto Serif SC", serif; font-weight: 700; font-size: 20px;
  color: var(--ink-0); letter-spacing: -0.01em;
}
.popup .grid .cell .val.accent { color: var(--cinnabar); }
.popup .grid .cell .val.full {
  font-size: 14px; font-family: "Fraunces", serif; font-weight: 500;
  color: var(--ink-1); letter-spacing: 0.02em;
}

/* ============================================================
   右侧面板
   ============================================================ */
.panel {
  background: var(--paper-1); border-left: 1px solid var(--line-2);
  overflow-y: auto; padding: 30px 34px 52px;
  display: flex; flex-direction: column; gap: 30px;
}
.panel::-webkit-scrollbar { width: 8px; }
.panel::-webkit-scrollbar-thumb { background: var(--ink-3); border-radius: 4px; }

.section .h {
  display: flex; align-items: baseline; justify-content: space-between;
  margin-bottom: 18px; padding-bottom: 14px;
  border-bottom: 1px solid var(--ink-0);
  position: relative;
}
.section .h::after {
  content: ""; position: absolute; bottom: -3px; left: 0; right: 0; height: 1px;
  background: var(--ink-0);
}
.section .h .title {
  font-family: "Noto Serif SC", serif; font-weight: 900; font-size: 19px;
  color: var(--ink-0); letter-spacing: 0.05em;
}
.section .h .title .dot { color: var(--cinnabar); margin: 0 6px; font-weight: 400; }
.section .h .badge {
  font-family: "Fraunces", serif; font-style: italic; font-size: 13px;
  color: var(--ink-2); font-weight: 500;
}

/* 指标分段切换 —— 4 列 */
.metric-segs {
  display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 0;
  border: 1px solid var(--ink-0); border-radius: 10px; overflow: hidden;
  background: var(--paper-2);
}
.metric-segs .seg {
  padding: 14px 4px; text-align: center; cursor: pointer; user-select: none;
  background: transparent; border-right: 1px solid var(--line-2);
  transition: all 0.2s ease; position: relative;
}
.metric-segs .seg:last-child { border-right: none; }
.metric-segs .seg .label {
  font-family: "Noto Serif SC", serif; font-weight: 700; font-size: 14.5px;
  color: var(--ink-1); letter-spacing: 0.03em;
}
.metric-segs .seg.active { background: var(--ink-0); }
.metric-segs .seg.active .label { color: var(--paper-2); }
.metric-segs .seg.active::before {
  content: ""; position: absolute; top: 5px; left: 50%; transform: translateX(-50%);
  width: 6px; height: 6px; border-radius: 50%; background: var(--cinnabar);
}
.metric-segs .seg:hover:not(.active) { background: rgba(197,70,46,0.04); }

/* 层级筛选 */
.level-pills { display: flex; flex-wrap: wrap; gap: 8px; }
.pill {
  padding: 10px 18px; font-size: 14px; cursor: pointer; user-select: none;
  background: var(--paper-2); border: 1px solid var(--line-2); border-radius: 100px;
  color: var(--ink-1); transition: all 0.2s ease;
  font-family: "Noto Serif SC", serif; font-weight: 500;
}
.pill:hover { border-color: var(--ink-0); color: var(--ink-0); }
.pill.active {
  background: var(--ink-0); color: var(--paper-2); border-color: var(--ink-0);
  box-shadow: 0 2px 0 var(--cinnabar);
}

/* 开关 */
.toggles { display: flex; flex-direction: column; gap: 4px; }
.tog-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 0; font-size: 15px; color: var(--ink-0);
}
.tog-row .lbl { display: flex; align-items: center; gap: 12px; font-family: "Noto Serif SC", serif; font-weight: 500; }
.tog-row .ico { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.tog-row .ico.heat {
  background: linear-gradient(135deg, #7fbf8c, #d9a14f, #c5462e);
  box-shadow: 0 0 8px rgba(197,70,46,0.4);
}
.tog-row .ico.dot { background: var(--ink-0); box-shadow: 0 0 0 2px var(--paper-1), 0 0 0 3px var(--ink-0); }
.tog-row .ico.ring { background: transparent; border: 2px solid var(--mgr-b); }
.tog-row .ico.star {
  background: var(--cinnabar);
  clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  border-radius: 0;
}
.tog { position: relative; width: 40px; height: 22px; }
.tog input { opacity: 0; width: 0; height: 0; }
.tog .trk {
  position: absolute; inset: 0; background: var(--paper-2); border: 1px solid var(--line-2);
  border-radius: 100px; cursor: pointer; transition: 0.25s;
}
.tog .trk::before {
  content: ""; position: absolute; width: 16px; height: 16px; left: 2px; top: 2px;
  background: var(--ink-2); border-radius: 50%; transition: 0.25s;
}
.tog input:checked + .trk { background: var(--cinnabar); border-color: var(--cinnabar); }
.tog input:checked + .trk::before { left: 20px; background: var(--paper-2); }

/* 排行榜 */
.rank-table { display: flex; flex-direction: column; }
.rank-row {
  display: grid; grid-template-columns: 36px 1fr auto;
  padding: 14px 0; gap: 14px; align-items: center;
  border-bottom: 1px solid var(--line);
  cursor: pointer; transition: background 0.15s;
}
.rank-row:last-child { border-bottom: none; }
.rank-row:hover { background: rgba(197,70,46,0.05); }
.rank-row .num {
  font-family: "Fraunces", serif; font-style: italic; font-weight: 500;
  font-size: 22px; color: var(--ink-3); text-align: right; line-height: 1;
}
.rank-row.top1 .num { color: var(--cinnabar); font-weight: 900; }
.rank-row.top2 .num { color: var(--amber); font-weight: 700; }
.rank-row.top3 .num { color: var(--jade); font-weight: 700; }
.rank-row .info { min-width: 0; }
.rank-row .name {
  font-family: "Noto Serif SC", serif; font-weight: 700; font-size: 15px;
  color: var(--ink-0); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  margin-bottom: 4px; letter-spacing: 0.02em;
  display: flex; align-items: center; gap: 7px;
}
.rank-row .name .mgr-dot {
  display: inline-block; width: 8px; height: 8px; border-radius: 1.5px; flex-shrink: 0;
}
.rank-row .name .mgr-dot.m-a { background: var(--mgr-a); }
.rank-row .name .mgr-dot.m-b   { background: var(--mgr-b); }
.rank-row .lvl {
  font-size: 12px; color: var(--ink-2); letter-spacing: 0.05em;
}
.rank-row .val {
  font-family: "Fraunces", "Noto Serif SC", serif; font-size: 15.5px; font-weight: 700;
  color: var(--cinnabar); white-space: nowrap;
}

/* 入场动画 */
@keyframes rise { from { opacity: 0; transform: translateY(10px) } to { opacity: 1; transform: none } }
.section, .legend, .geo-tag, .ribbon .kpi, .mgr-tab { animation: rise 0.7s cubic-bezier(0.16,1,0.3,1) both; }
.section:nth-child(1) { animation-delay: 0.05s }
.section:nth-child(2) { animation-delay: 0.13s }
.section:nth-child(3) { animation-delay: 0.21s }
.section:nth-child(4) { animation-delay: 0.29s }
.legend { animation-delay: 0.4s }
.geo-tag { animation-delay: 0.5s }
.ribbon .kpi:nth-child(1) { animation-delay: 0.05s }
.ribbon .kpi:nth-child(2) { animation-delay: 0.10s }
.ribbon .kpi:nth-child(3) { animation-delay: 0.15s }
.ribbon .kpi:nth-child(4) { animation-delay: 0.20s }
.mgr-tab:nth-child(1) { animation-delay: 0.05s }
.mgr-tab:nth-child(2) { animation-delay: 0.10s }
.mgr-tab:nth-child(3) { animation-delay: 0.15s }

/* 空数据提示 */
.empty {
  font-family: "Noto Serif SC", serif; font-style: italic; font-size: 15px;
  color: var(--ink-3); text-align: center; padding: 36px 0;
}

/* ============================================================
   v5 · 市州边界层 —— 浅蓝底线勾勒行政范围
   ============================================================ */
.city-outline      { transition: opacity .2s ease; }
.city-label {
  font-family: "Noto Serif SC", serif; font-weight: 700; font-size: 12.5px;
  color: #4a7fb0; letter-spacing: 0.06em; white-space: nowrap;
  text-shadow: 0 0 3px #fffbf2, 0 0 6px #fffbf2, 0 1px 0 #fffbf2;
  pointer-events: none; transform: translate(-50%, -50%);
}
.city-label.is-mine { color: #2f6ea8; font-size: 13.5px; }
.tog-row .ico.bound {
  background: rgba(143,184,220,0.35); border: 1.5px solid #8fb8dc; border-radius: 3px;
}
</style>
