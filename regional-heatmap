/** 当前所选区域在哪些市州有景点 —— 由 RAW 数据推导，不额外维护名单 */
function myCityNames() {
  const regions = filteredByMgr().map(d => d.region);
  return new Set(
    CITY_BOUNDARIES
      .filter(c => regions.some(r => r.includes(cityKey(c.n))))
      .map(c => c.n)
  );
}

function buildBoundaries() {
  CITY_BOUNDARIES.forEach(c => {
    const poly = L.polygon(c.r, {
      ...BOUND_STYLE.other,
      pane: 'boundaryPane',
      className: 'city-outline',
      interactive: false,
    });
    boundaryShapes.push({ name: c.n, poly });
    boundaryLayer.addLayer(poly);

    const label = L.marker(c.c, {
      pane: 'cityLabelPane',
      interactive: false,
      icon: L.divIcon({ className: '', html: '<div class="city-label">' + cityKey(c.n) + '</div>', iconSize: [0, 0] }),
    });
    cityLabelLayer.addLayer(label);
  });
}

/** 区域切换后重新分色：覆盖市州加深，其余保持浅蓝底线 */
function restyleBoundaries() {
  const mine = myCityNames();
  boundaryShapes.forEach(({ name, poly }) => {
    poly.setStyle(mine.has(name) ? BOUND_STYLE.mine : BOUND_STYLE.other);
  });
  cityLabelLayer.eachLayer(mk => {
    const el = mk.getElement()?.querySelector('.city-label');
    if (el) el.classList.toggle('is-mine', mine.has(mk._cityName));
  });
}

function renderBoundaries() {
  if (state.boundary) {
    boundaryLayer.addTo(map);
    cityLabelLayer.addTo(map);
    restyleBoundaries();
  } else {
    map.removeLayer(boundaryLayer);
    map.removeLayer(cityLabelLayer);
  }
}

buildBoundaries();
/* 标注与市州名绑定，供 restyle 时定位 */
cityLabelLayer.getLayers().forEach((mk, i) => { mk._cityName = CITY_BOUNDARIES[i].n; });

/* ============================================================
   热力图 —— v4 · 两阶段 Canvas 渲染(区域总量热力)
   核心:先在离屏 canvas 用"值加权 alpha"叠加每个景点的高斯光斑,
        再将累计 alpha 值查表 → 蓝紫→红 的热力渐变。
        - 每点强度 = value / refMax,决定光斑 alpha 与半径
        - 相邻点的光斑在离屏 canvas 上以 alpha 相加(自然形成"区域总量")
        - 高聚集区(如四姑娘山周边、九寨沟周边) alpha 累计更高 → 更红
        - 归一化分母 refMax 已剔除极值(头部单点),避免"一个盖全场"
        - Gradient 使用 HEAT_STOPS(蓝紫→绿→黄→橙→红),贴近参考图风格
   ============================================================ */
const HeatCanvas = L.Layer.extend({
  initialize(data, opts) {
    this._data = data;
    this._max = opts.max;
    this._metric = opts.metric;
  },
  setData(data, opts) {
    this._data = data;
    this._max = opts.max;
    this._metric = opts.metric;
    if (this._canvas) this._redraw();
  },
  onAdd(map) {
    this._map = map;
    if (!this._canvas) {
      this._canvas = L.DomUtil.create('canvas', 'leaflet-heat-canvas');
      this._canvas.style.position = 'absolute';
      this._canvas.style.pointerEvents = 'none';
      this._canvas.style.zIndex = 350;
      this._canvas.style.transition = 'opacity 0.15s ease';
      this._canvas.style.willChange = 'opacity';
    }
    map.getPanes().overlayPane.appendChild(this._canvas);
    // v4-fix · 缩放/平移过程中 canvas 与地图 tile 不同步,会形成"重影/错位"。
    //           改为:交互开始 → 隐藏 canvas;交互结束 → 重绘并淡入。
    this._onZoomStart = () => { this._canvas.style.opacity = '0'; };
    this._onZoomEnd   = () => { this._redraw(); this._canvas.style.opacity = '1'; };
    this._onMoveStart = () => { this._canvas.style.opacity = '0'; };
    this._onMoveEnd   = () => { this._redraw(); this._canvas.style.opacity = '1'; };
    this._onResize    = () => { this._redraw(); };
    map.on('zoomstart', this._onZoomStart, this);
    map.on('zoomend',   this._onZoomEnd,   this);
    map.on('movestart', this._onMoveStart, this);
    map.on('moveend',   this._onMoveEnd,   this);
    map.on('resize viewreset', this._onResize, this);
    this._redraw();
  },
  onRemove(map) {
    if (this._canvas && this._canvas.parentNode) {
      this._canvas.parentNode.removeChild(this._canvas);
    }
    map.off('zoomstart', this._onZoomStart, this);
    map.off('zoomend',   this._onZoomEnd,   this);
    map.off('movestart', this._onMoveStart, this);
    map.off('moveend',   this._onMoveEnd,   this);
    map.off('resize viewreset', this._onResize, this);
  },
  _redraw() {
    if (!this._map || !this._canvas) return;
    const map = this._map;
    const size = map.getSize();
    const cvs = this._canvas;
    cvs.width = size.x; cvs.height = size.y;
    const tl = map.containerPointToLayerPoint([0, 0]);
    L.DomUtil.setPosition(cvs, tl);

    const ctx = cvs.getContext('2d');
    ctx.clearRect(0, 0, size.x, size.y);

    // 缩放自适应半径
    const z = map.getZoom();
    const baseR = Math.max(46, 30 + (z - 6) * 18);

    const max = this._max || 1;

    /* --- 阶段 A · 离屏画布上叠加每个点的"值加权"高斯 alpha --- */
    const off = document.createElement('canvas');
    off.width = size.x; off.height = size.y;
    const octx = off.getContext('2d');
    octx.globalCompositeOperation = 'lighter';   // alpha 累加,形成"区域总量"

    this._data.forEach(d => {
      const v = d[this._metric];
      if (v <= 0) return;
      // v4-fix · 极值(如九寨沟)之前被 refMax 剔除后 t 值被 clamp 到 1,
      //         导致九寨沟位置在热力上反而不如"多点密集但值中等"的区域红。
      //         这里对极值单独放大 peak alpha,让极值本身就是饱和红,
      //         邻近正常点仍能继续累加,视觉与业务量一致。
      const isOutlier = state.excludeOutlier && OUTLIER_NAMES.has(d.name);
      const t = isOutlier ? 1.0 : Math.max(0, Math.min(1, v / max));
      // 半径:极值给大一档
      const r = baseR * (isOutlier ? 1.20 : (0.5 + 0.6 * Math.pow(t, 0.4)));
      // 单点最大 alpha:极值 0.95(近饱和红),普通点 0.55 封顶
      const peak = isOutlier ? 0.95 : (0.15 + 0.4 * Math.pow(t, 0.55));
      const p = map.latLngToContainerPoint([d.lat, d.lng]);
      const g = octx.createRadialGradient(p.x, p.y, 0, p.x, p.y, r);
      g.addColorStop(0.0, `rgba(0,0,0,${peak})`);
      g.addColorStop(0.5, `rgba(0,0,0,${peak * 0.42})`);
      g.addColorStop(1.0, 'rgba(0,0,0,0)');
      octx.fillStyle = g;
      octx.beginPath();
      octx.arc(p.x, p.y, r, 0, Math.PI * 2);
      octx.fill();
    });

    /* --- 阶段 B · 读离屏 alpha → 查 HEAT_STOPS 渐变色写主画布 --- */
    // 预生成 256 色查找表(蓝紫 → 红)
    const lut = HeatCanvas._lut || (HeatCanvas._lut = HeatCanvas._buildLUT());
    const src = octx.getImageData(0, 0, size.x, size.y);
    const dst = ctx.createImageData(size.x, size.y);
    const sd = src.data, dd = dst.data;
    for (let i = 0; i < sd.length; i += 4) {
      const a = sd[i + 3];   // 累计 alpha (0..255)
      if (a === 0) continue;
      // 曲线放大低-中值(视觉更铺开、更贴近参考图)
      const idx = Math.min(255, Math.round(Math.pow(a / 255, 0.85) * 255));
      const c = lut[idx];
      dd[i]   = c[0];
      dd[i+1] = c[1];
      dd[i+2] = c[2];
      dd[i+3] = Math.min(230, a + 30);   // 让边缘也可见
    }
    ctx.putImageData(dst, 0, 0);
  },
});

HeatCanvas._buildLUT = function() {
  const lut = new Array(256);
  for (let i = 0; i < 256; i++) {
    const c = tintHeat(i / 255).match(/\d+/g).map(Number);
    lut[i] = [c[0], c[1], c[2]];
  }
  return lut;
};

let heatLayer = null;
const markerLayer = L.layerGroup().addTo(map);

function renderHeat(data) {
  if (heatLayer) { map.removeLayer(heatLayer); heatLayer = null; }
  if (!state.heat || data.length === 0) return;
  const max = refMaxFor(data, state.metric);   // v4:剔除极值后归整
  heatLayer = new HeatCanvas(data, { max, metric: state.metric });
  heatLayer.addTo(map);
}

/* ============================================================
   标记 —— v4:统一墨色,仅四大景区(九寨沟、黄龙、四姑娘山、达古冰川)朱砂高亮
   ============================================================ */
function renderMarkers(data) {
  markerLayer.clearLayers();
  if (!state.mark) return;

  data.forEach(d => {
    const highlighted = HIGHLIGHT_NAMES.has(d.name);
    const mgrClass = state.mgrRing ? ` m-${d.mgr}` : '';
    const hlClass = highlighted ? ' hl' : '';
    const icon = L.divIcon({
      className: '',
      html: `<div class="attr-marker${mgrClass}${hlClass}"></div>`,
      iconSize: [14,14], iconAnchor: [7,7], popupAnchor: [0,-9]
    });
    const m = L.marker([d.lat, d.lng], { icon, riseOnHover: true, zIndexOffset: highlighted ? 1000 : 0 });
    m.bindPopup(popupHTML(d), { maxWidth: 380, closeButton: true, autoPan: true });
    m._d = d;
    markerLayer.addLayer(m);
  });
}

function popupHTML(d) {
  const mgrName = d.mgr === 'a' ? '区域 A' : '区域 B';
  return `
    <div class="popup">
      <div class="tag-row">
        <span class="tag">${d.level}</span>
        <span class="mgr-chip m-${d.mgr}">${mgrName}</span>
      </div>
      <div class="ttl">${d.name}</div>
      <div class="region">${d.region}</div>
      <div class="grid">
        <div class="cell">
          <div class="lbl">GMV(总营业额)</div>
          <div class="val accent">¥${fmtMoney(d.gmv)}</div>
        </div>
        <div class="cell">
          <div class="lbl">毛利值</div>
          <div class="val">¥${fmtMoney(d.profit)}</div>
        </div>
        <div class="cell">
          <div class="lbl">毛利率</div>
          <div class="val">${d.margin.toFixed(2)}%</div>
        </div>
        <div class="cell">
          <div class="lbl">单客价值</div>
          <div class="val">¥${d.arpu.toFixed(2)}</div>
        </div>
        <div class="cell">
          <div class="lbl">成交票量</div>
          <div class="val full">${d.tickets.toLocaleString()} 张</div>
        </div>
        <div class="cell">
          <div class="lbl">地理坐标</div>
          <div class="val full">${d.lat.toFixed(3)}°N · ${d.lng.toFixed(3)}°E</div>
        </div>
      </div>
    </div>
  `;
}

/* ============================================================
   KPI
   ============================================================ */
function updateKPIs(data) {
  const tot   = data.reduce((s,d) => s + d.gmv, 0);
  const prof  = data.reduce((s,d) => s + d.profit, 0);
  const mar   = tot ? (prof/tot*100) : 0;
  document.getElementById('kpi-count').innerHTML  = data.length + '<span class="unit">个</span>';
  document.getElementById('kpi-gmv').innerHTML    = '¥' + fmtMoney(tot);
  document.getElementById('kpi-profit').innerHTML = '¥' + fmtMoney(prof);
  document.getElementById('kpi-margin').innerHTML = mar.toFixed(2) + '<span class="unit">%</span>';
}

/* ============================================================
   图例
   ============================================================ */
/* 图例的最大值向上"归整":
   金额 → 亿/万/千 的整数级别；毛利率 → 5% 步进的整数百分比；
   单客价值 → 50 / 10 的整数步进。 */
/* v4 · 统一"归一化参考最大值":
   - excludeOutlier=true 时,把 OUTLIER_NAMES 名单里的景点剔除后再取 max
   - 再向上归整成整亿/整万/5%,与图例读数保持一致
   若剔除后为空(极端情况),回退到原始最大值 */
function refMaxFor(data, metric) {
  const clean = state.excludeOutlier
    ? data.filter(d => !OUTLIER_NAMES.has(d.name))
    : data;
  const pool = clean.length ? clean : data;
  const rawMax = Math.max(...pool.map(d => d[metric]));
  return roundUpNice(rawMax, metric);
}

function roundUpNice(val, metric) {
  if (val <= 0) return metric === 'margin' ? 1 : 100;
  if (metric === 'margin') {
    // 5% 步进(0.05 之内的最大值,保证 4.57 -> 5, 23.36 -> 25)
    return Math.ceil(val / 5) * 5;
  }
  if (metric === 'arpu') {
    if (val >= 100) return Math.ceil(val / 50) * 50;
    if (val >= 20)  return Math.ceil(val / 10) * 10;
    return Math.ceil(val / 5) * 5;
  }
  // gmv / profit: 亿 / 千万 / 百万 / 万 / 千 的整数
  if (val >= 1e8)  return Math.ceil(val / 1e8)  * 1e8;
  if (val >= 1e7)  return Math.ceil(val / 1e7)  * 1e7;
  if (val >= 1e6)  return Math.ceil(val / 1e6)  * 1e6;
  if (val >= 1e5)  return Math.ceil(val / 1e5)  * 1e5;
  if (val >= 1e4)  return Math.ceil(val / 1e4)  * 1e4;
  return Math.ceil(val / 1e3) * 1e3;
}

function updateLegend(data) {
  document.getElementById('legend-title').innerHTML =
    `${M_LABEL[state.metric]} <em>·</em> 热力分布`;
  if (!data.length) {
    ['legend-min','legend-mid','legend-max'].forEach(id =>
      document.getElementById(id).textContent = '—');
    return;
  }
  const min = 0;
  // v4-fix:图例上限使用原始 max(含极值),避免"6000万"歧义。
  //         内部颜色分档才用剔除极值后的 refMax。
  const rawMax = Math.max(...data.map(d => d[state.metric]));
  const max = roundUpNice(rawMax, state.metric);
  const mid = (min + max) / 2;
  document.getElementById('legend-min').textContent = fmtMetric(min, state.metric);
  document.getElementById('legend-mid').textContent = fmtMetric(mid, state.metric);
  document.getElementById('legend-max').textContent = fmtMetric(max, state.metric);
}

/* ============================================================
   排行榜 —— 修复 Bug 2:重影
   问题:setTimeout(openPopup, 900) 与 flyTo 时机不同步,且旧 popup
        未关闭导致同时残留两个 popup + hover 视觉停留。
   修法:1) 点击瞬间 map.closePopup(),清理所有已开弹窗
        2) 用 map.once('moveend', ...) 精确等 flyTo 完成再 openPopup
        3) 每次 render 前 map.closePopup(),避免 rerender 时 DOM 残留
   ============================================================ */
function updateRank(data) {
  const sorted = [...data].sort((a,b) => b[state.metric] - a[state.metric]).slice(0, 10);
  const html = sorted.map((d, i) => `
    <div class="rank-row ${i===0?'top1':i===1?'top2':i===2?'top3':''}" data-name="${d.name}">
      <div class="num">${String(i+1).padStart(2,'0')}</div>
      <div class="info">
        <div class="name" title="${d.name}"><span class="mgr-dot m-${d.mgr}"></span>${d.name}</div>
        <div class="lvl">${d.level} · ${d.region.replace('四川省','')}</div>
      </div>
      <div class="val">${fmtMetric(d[state.metric], state.metric)}</div>
    </div>
  `).join('');
  const t = document.getElementById('rank-table');
  t.innerHTML = html || '<div class="empty">暂无数据</div>';
  t.querySelectorAll('.rank-row').forEach(r => {
    r.onclick = () => flyToAttr(r.dataset.name);
  });
  document.getElementById('rank-meta').textContent =
    `前 ${Math.min(10, sorted.length)} 名 · ${M_LABEL[state.metric]}`;
}

function flyToAttr(nm) {
  map.closePopup();
  let target = null;
  markerLayer.eachLayer(mk => { if (mk._d && mk._d.name === nm) target = mk; });
  if (!target) return;
  map.once('moveend', () => {
    map.closePopup();
    target.openPopup();
  });
  map.flyTo([target._d.lat, target._d.lng], Math.max(map.getZoom(), 9), {
    duration: 0.9, easeLinearity: 0.25
  });
}

/* ============================================================
   区域切换
   ============================================================ */
function applyMgr() {
  const info = MGR_LABEL[state.mgr];
  document.getElementById('brand-sub').textContent =
    state.mgr === 'all'
      ? `西南区域 · 四川 · 双区域 · ${filteredByMgr().length} 处景点`
      : `${info.region} · ${filteredByMgr().length} 处景点`;
  const geoMgr = document.getElementById('geo-mgr');
  geoMgr.textContent = info.name;
  geoMgr.setAttribute('data-m', state.mgr === 'all' ? '' : state.mgr);

  const pts = filteredByMgr().map(d => [d.lat, d.lng]);
  if (pts.length) {
    map.fitBounds(pts, { padding: [80, 80], maxZoom: 8, animate: true, duration: 0.9 });
  }

  const lats = pts.map(p => p[0]), lngs = pts.map(p => p[1]);
  const minLat = Math.min(...lats).toFixed(1), maxLat = Math.max(...lats).toFixed(1);
  const minLng = Math.min(...lngs).toFixed(1), maxLng = Math.max(...lngs).toFixed(1);
  document.getElementById('geo-coord').textContent =
    `N ${minLat}° — ${maxLat}°　E ${minLng}° — ${maxLng}°`;
}

function filteredByMgr() {
  return state.mgr === 'all' ? RAW : RAW.filter(d => d.mgr === state.mgr);
}

/* ============================================================
   渲染编排
   ============================================================ */
function render() {
  map.closePopup();
  let data = filteredByMgr();
  if (state.level !== '全部') data = data.filter(d => d.level === state.level);
  renderHeat(data);
  renderMarkers(data);
  updateKPIs(data);
  updateLegend(data);
  updateRank(data);
}

/* ============================================================
   初始化筛选与事件
   ============================================================ */
function initLevelPills() {
  const levels = ['全部', '头部景区', '重点景区', '长尾景区']
    .filter(l => l === '全部' || RAW.some(d => d.level === l));
  const c = document.getElementById('level-pills');
  c.innerHTML = levels.map(l =>
    `<div class="pill ${l==='全部'?'active':''}" data-level="${l}">${l}</div>`
  ).join('');
  c.querySelectorAll('.pill').forEach(p => p.onclick = () => {
    c.querySelectorAll('.pill').forEach(x => x.classList.remove('active'));
    p.classList.add('active');
    state.level = p.dataset.level;
    render();
  });
}

document.querySelectorAll('#metric-segs .seg').forEach(s => s.onclick = () => {
  document.querySelectorAll('#metric-segs .seg').forEach(x => x.classList.remove('active'));
  s.classList.add('active');
  state.metric = s.dataset.metric;
  render();
});

document.getElementById('t-heat').onchange = e => { state.heat = e.target.checked; render(); };
document.getElementById('t-mark').onchange = e => { state.mark = e.target.checked; render(); };
document.getElementById('t-mgr').onchange  = e => { state.mgrRing = e.target.checked; render(); };
document.getElementById('t-outlier').onchange = e => { state.excludeOutlier = e.target.checked; render(); };
document.getElementById('t-bound').onchange = e => { state.boundary = e.target.checked; renderBoundaries(); };

document.querySelectorAll('#mgr-tabs .mgr-tab').forEach(t => t.onclick = () => {
  document.querySelectorAll('#mgr-tabs .mgr-tab').forEach(x => x.classList.remove('active'));
  t.classList.add('active');
  state.mgr = t.dataset.mgr;
  applyMgr();
  restyleBoundaries();
  render();
});

initLevelPills();
applyMgr();
renderBoundaries();
render();
</script>
</body>
</html>
