/* v4 · 参考图风格的热力渐变 (蓝紫 → 青绿 → 黄 → 橙 → 红)
   仅用于底层热力斑,与图例本身仍沿用米白纸面主色不冲突 */
const HEAT_STOPS = [
  [0.00, [ 82, 96,180]],  // 蓝紫
  [0.20, [ 95,161,215]],  // 蓝
  [0.40, [122,199,145]],  // 绿
